<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.distribution.template</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//list[@name='journal_items']//field[@name='analytic_distribution']"
                position="before"
            >
                <field
                    name="distribution_template_id"
                    optional="hide"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
