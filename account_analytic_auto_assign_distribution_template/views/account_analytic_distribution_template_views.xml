<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_analytic_distribution_template_list_view" model="ir.ui.view">
        <field name="name">account.analytic.distribution.template.list</field>
        <field name="model">account.analytic.distribution.template</field>
        <field name="arch" type="xml">
            <list string="Distribution Templates" editable="top" open_form_view="True">
                <field name="name" />
                <field name="company_id" column_invisible="True" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                    placeholder="Visible to all"
                />
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    options="{'force_applicability': 'optional', 'disable_save': true}"
                />
            </list>
        </field>
    </record>

    <record id="account_analytic_distribution_template_form_view" model="ir.ui.view">
        <field name="name">account.analytic.distribution.template.form</field>
        <field name="model">account.analytic.distribution.template</field>
        <field name="arch" type="xml">
            <form string="Distribution Template">
                <sheet>
                    <group>
                        <field name="name" />
                        <field
                            name="company_id"
                            groups="base.group_multi_company"
                            placeholder="Visible to all"
                        />
                        <field
                            name="analytic_distribution"
                            widget="analytic_distribution"
                            options="{'force_applicability': 'optional', 'disable_save': true}"
                            class="w-50"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record
        id="action_account_analytic_distribution_template"
        model="ir.actions.act_window"
    >
        <field name="name">Distribution Templates</field>
        <field name="res_model">account.analytic.distribution.template</field>
        <field name="path">analytic-distribution-templates</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_account_analytic_distribution_template"
        name="Distribution Templates"
        action="action_account_analytic_distribution_template"
        parent="account.menu_analytic_accounting"
        groups="analytic.group_analytic_accounting"
        sequence="20"
    />
</odoo>
