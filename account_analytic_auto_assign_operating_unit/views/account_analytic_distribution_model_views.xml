<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_analytic_distribution_model_tree_view" model="ir.ui.view">
        <field
            name="name"
        >account.analytic.distribution.model.list.operating.unit</field>
        <field name="model">account.analytic.distribution.model</field>
        <field
            name="inherit_id"
            ref="account.account_analytic_distribution_model_tree_inherit"
        />
        <field name="arch" type="xml">
            <field name="product_categ_id" position="after">
                <field
                    name="operating_unit_id"
                    optional="show"
                    groups="operating_unit.group_multi_operating_unit"
                />
            </field>
        </field>
    </record>

    <record id="account_analytic_distribution_model_form_view" model="ir.ui.view">
        <field
            name="name"
        >account.analytic.distribution.model.form.operating.unit</field>
        <field name="model">account.analytic.distribution.model</field>
        <field
            name="inherit_id"
            ref="account.account_analytic_distribution_model_form_inherit"
        />
        <field name="arch" type="xml">
            <field name="product_categ_id" position="after">
                <field
                    name="operating_unit_id"
                    groups="operating_unit.group_multi_operating_unit"
                />
            </field>
        </field>
    </record>
</odoo>
